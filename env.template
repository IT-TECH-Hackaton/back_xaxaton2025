APP_PORT=8080
APP_ENV=development

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=bekend
# sslmode для PostgreSQL: disable (dev), require (prod). В production по умолчанию require
DB_SSL_MODE=disable

JWT_SECRET=your-very-secret-key-change-in-production-min-32-characters-long
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=168h

# Cookie для refresh токена (production: COOKIE_SECURE=true, COOKIE_SAME_SITE=none для cross-origin)
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

EMAIL_HOST=smtp.yandex.ru
EMAIL_PORT=465
EMAIL_USER=your-email@yandex.ru
EMAIL_PASSWORD=your-password-here
EMAIL_FROM=your-email@yandex.ru

FRONTEND_URL=http://localhost:5173

# Яндекс OAuth
YANDEX_CLIENT_ID=your-yandex-client-id
YANDEX_CLIENT_SECRET=your-yandex-client-secret
YANDEX_REDIRECT_URI=http://localhost:8081/api/auth/yandex/callback

# Фейковая авторизация через Яндекс (для разработки, без реального OAuth)
FAKE_YANDEX_AUTH=false

# Яндекс.Геокодер API (для работы с картами)
YANDEX_GEOCODER_API_KEY=your-yandex-geocoder-api-key

# CORS настройки (разрешенные источники через запятую)
CORS_ALLOW_ORIGINS=http://localhost:5173

# ЮKassa (платежи)
YOOKASSA_SHOP_ID=your-shop-id
YOOKASSA_SECRET_KEY=your-secret-key
BACKEND_URL=http://localhost:8081
# Проверка IP whitelist для webhook (в production — true)
WEBHOOK_IP_CHECK=false

# Полный сид при старте (100+ пользователей, 100+ афиш) — для теста
SEED_FULL=false

